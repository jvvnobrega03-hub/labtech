{
  "name": "labtech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:sites": "npm run build:cloudflare && node scripts/stage-sites-build.mjs",
    "start": "next start",
