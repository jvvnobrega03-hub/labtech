# URL HTTPS pública e verificada, sem barra final. Enquanto estiver vazia,
# o site omite URLs canônicas absolutas, não gera sitemap e usa noindex.
NEXT_PUBLIC_SITE_URL=

# Opcionais: só configure informações comerciais verificadas.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=

# Envio do formulário de contato (somente no servidor).
# RESEND_API_KEY deve ser configurada como segredo na Vercel.
RESEND_API_KEY=
CONTACT_EMAIL_TO=site@labtech.com.br
CONTACT_EMAIL_FROM="Labtech <site@labtech.com.br>"
